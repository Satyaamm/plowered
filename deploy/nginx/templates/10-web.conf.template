# ${WEB_DOMAIN} — the Next.js web app.
#
# The /api/* path is also served from here (BFF pattern). The Next.js
# middleware injects the X-Gateway-Auth header server-side, then
# rewrites to http://plowered-api:8080 over the internal docker
# network. Browsers never see the gateway secret.
#
# Load balancing: the upstream is resolved through Docker's embedded
# DNS per request (resolver + variable proxy_pass), so scaling the
# web service (docker compose up -d --scale plowered-web=2) round-
# robins with no nginx change.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${WEB_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WEB_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WEB_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security_headers.conf;

    # Block known scanners outright. The map in nginx.conf flips a
    # flag based on user-agent; we return 403 without logging.
    if ($bad_bot) {
        return 403;
    }

    # General rate limit. Burst absorbs page-load spikes (a Next.js
    # render pulls 20+ assets in parallel). nodelay keeps the burst
    # at line-rate; the throttle kicks in after.
    limit_req zone=zone_general burst=60 nodelay;

    # ACME challenge still works during a cert renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Docker embedded DNS — re-resolve upstreams every 10s so scaled
    # replicas and recreated containers are picked up live.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Next.js standalone server.
    location / {
        include /etc/nginx/snippets/proxy_common.conf;
        set $web_upstream http://plowered-web:3000;
        proxy_pass $web_upstream;
    }
}
