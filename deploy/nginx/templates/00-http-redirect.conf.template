# Port 80 — only carries the ACME webroot challenge + redirects every
# other request to HTTPS. Applies to both subdomains.
#
# This file is an envsubst template: ${WEB_DOMAIN} and ${API_DOMAIN}
# come from the nginx container's environment (set in compose).
# nginx's own runtime variables ($host, $request_uri, …) are NOT in
# the environment, so the entrypoint leaves them alone.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${WEB_DOMAIN} ${API_DOMAIN};

    # /healthz served straight on port 80 so the docker healthcheck +
    # any external uptime probe still works during cert renewal.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # ACME http-01 challenge. certbot drops tokens here; LE retrieves
    # them. Don't move /var/www/certbot — the certbot container
    # writes the same path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else: 301 to the HTTPS equivalent.
    location / {
        return 301 https://$host$request_uri;
    }
}
