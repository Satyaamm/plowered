# ${API_DOMAIN} — the backend API for direct (non-browser) callers:
# CLIs, SDK consumers, partner integrations.
#
# Browsers don't need this subdomain. They hit /api/* on the web
# vhost and the BFF rewrites to the API over the internal docker
# network with the gateway header injected. This subdomain exists for:
#   1. /openapi.yaml + /docs (Swagger UI) — shareable integration docs.
#   2. /healthz + /readyz for external uptime probes.
#   3. A direct CLI/SDK path. Callers must present X-Gateway-Auth
#      themselves (nginx returns a JSON 401 when they don't).
#
# Load balancing: same per-request Docker-DNS resolution as the web
# vhost — docker compose up -d --scale plowered-api=3 just works.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security_headers.conf;

    if ($bad_bot) {
        return 403;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Docker embedded DNS — re-resolve per request window.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Health probes — bypass the gateway gate so external uptime
    # checks don't need the secret. The app's GATEWAY_SKIP_PATHS
    # also skips these.
    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }
    location = /readyz {
        access_log off;
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }
    location = /metrics {
        # Allow only docker private bridges (Prometheus pull target).
        # 403 to the public internet keeps the metrics surface off
        # the scanner radar.
        allow 172.16.0.0/12;
        allow 10.0.0.0/8;
        deny all;
        access_log off;
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }

    # OpenAPI + Swagger UI — public. No auth required to read the spec.
    location = /openapi.yaml {
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }
    location = /docs {
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }

    # /v1/auth/* — public by definition (signup, login, verify,
    # password reset). Tighter per-IP rate limit because this is the
    # brute-force surface. The app also enforces a 5-fails-in-15min
    # account lockout.
    location ~ ^/v1/auth/ {
        limit_req zone=zone_auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }

    # Everything else: API surface. nginx demands the gateway header
    # (the API's GatewayAuthMW is a second check).
    location / {
        limit_req zone=zone_general burst=60 nodelay;

        if ($http_x_gateway_auth = "") {
            return 401 '{"error":"gateway_required","message":"this API requires X-Gateway-Auth"}';
        }

        include /etc/nginx/snippets/proxy_common.conf;
        set $api_upstream http://plowered-api:8080;
        proxy_pass $api_upstream;
    }

    # Custom JSON error pages — friendlier than nginx's default HTML
    # when an SDK gets back a 502.
    error_page 401 = @json_401;
    error_page 403 = @json_403;
    error_page 502 503 504 = @json_5xx;

    location @json_401 {
        default_type application/json;
        return 401 '{"error":"unauthorized","message":"gateway auth missing or invalid"}';
    }
    location @json_403 {
        default_type application/json;
        return 403 '{"error":"forbidden","message":"request rejected by edge"}';
    }
    location @json_5xx {
        default_type application/json;
        return 503 '{"error":"upstream_unavailable","message":"plowered-api is not responding; try again shortly"}';
    }
}
