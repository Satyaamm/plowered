# .env.production.example — template for the production compose stack.
#
# Copy to .env.production, then run ./deploy/secrets-gen.sh to fill in
# every "GENERATE" placeholder with cryptographically-random values.
#
# Never commit .env.production — it ends up holding the master key for
# every secret stored in the vault.

# ---- Domains ----------------------------------------------------------
PLOWERED_WEB_BASE_URL=https://plowered.s2datasystems.in
# The cookie scope lets the session cookie set by ploweredapi be read
# by the web app on plowered. The leading dot is important.
PLOWERED_SESSION_COOKIE_DOMAIN=.s2datasystems.in

# ---- Postgres ---------------------------------------------------------
POSTGRES_DB=plowered
POSTGRES_USER=plowered
# 32+ chars, no quotes, no $ symbols. secrets-gen.sh writes one for you.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD

# ---- Redis ------------------------------------------------------------
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD

# ---- MinIO ------------------------------------------------------------
# Used both as the bucket access key AND as the AWS_*_ID/SECRET the
# API container passes to the S3 client (MinIO is S3-compatible).
MINIO_ROOT_USER=plowered
MINIO_ROOT_PASSWORD=GENERATE_MINIO_PASSWORD

# ---- Object store ----------------------------------------------------
# Default points at the bundled MinIO. To use real AWS S3, change the
# kind + drop the AWS_ENDPOINT_URL line + supply real AWS creds.
PLOWERED_OBJECT_STORE_KIND=s3
PLOWERED_OBJECT_STORE_BUCKET=plowered
PLOWERED_OBJECT_STORE_REGION=us-east-1

# ---- Cryptographic envs ----------------------------------------------
# 32-byte base64 — seals every secret stored via the vault.
PLOWERED_SECRETS_MASTER_KEY=GENERATE_MASTER_KEY
# 32-byte base64 — symmetric session JWT secret.
PLOWERED_JWT_HS256_SECRET=GENERATE_JWT_SECRET
# 32-byte base64 — gateway-auth shared secret. nginx + the Next.js
# middleware both inject this header; the API rejects requests
# without it.
PLOWERED_GATEWAY_SECRET=GENERATE_GATEWAY_SECRET

# ---- Email ------------------------------------------------------------
# Resend domain-verified API key. Without it, signup verification
# emails are written to the API container logs and verification has
# to happen via /verify?token=<token> by hand.
PLOWERED_RESEND_API_KEY=
PLOWERED_EMAIL_FROM=Plowered <noreply@s2datasystems.in>

# ---- Observability ---------------------------------------------------
PLOWERED_LOG_LEVEL=info
PLOWERED_VERSION=prod
