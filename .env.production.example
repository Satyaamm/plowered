# .env.production.example — template for the production compose stack.
#
# Run ./deploy/secrets-gen.sh to produce .env.production: it copies
# this file and fills every "GENERATE_*" placeholder with a fresh
# cryptographically-random value.
#
# Never commit .env.production — it holds the master key for every
# secret stored in the vault.

# ---- Domains ----------------------------------------------------------
# The web app and the direct-API hostname. Both need DNS A records
# pointing at this VPS before ./deploy/init-certs.sh can issue certs.
WEB_DOMAIN=plowered.s2datasystems.com
API_DOMAIN=ploweredapi.s2datasystems.com
# Cookie scope: the parent domain shared by both hosts. Leading dot
# matters — it lets the session cookie set by the API ride on the web
# origin too.
PLOWERED_SESSION_COOKIE_DOMAIN=.s2datasystems.com

# ---- Postgres (bundled container) --------------------------------------
POSTGRES_DB=plowered
POSTGRES_USER=plowered
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD

# ---- Redis (bundled container) ------------------------------------------
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD

# ---- MinIO (bundled container, S3-compatible object store) --------------
# Used both as the MinIO root credentials AND as the AWS key pair the
# API/worker pass to the S3 client.
MINIO_ROOT_USER=plowered
MINIO_ROOT_PASSWORD=GENERATE_MINIO_PASSWORD

# ---- Object store -------------------------------------------------------
# Defaults point at the bundled MinIO. To use AWS S3 / Azure Blob /
# GCS instead, change PLOWERED_OBJECT_STORE_KIND and supply that
# backend's env (see .env.example for the full per-kind contract).
PLOWERED_OBJECT_STORE_KIND=s3
PLOWERED_OBJECT_STORE_BUCKET=plowered
PLOWERED_OBJECT_STORE_REGION=us-east-1

# ---- Cryptographic envs --------------------------------------------------
# 32-byte base64 — seals every secret stored via the vault.
PLOWERED_SECRETS_MASTER_KEY=GENERATE_MASTER_KEY
# 32-byte base64 — symmetric session JWT secret.
PLOWERED_JWT_HS256_SECRET=GENERATE_JWT_SECRET
# 32-byte base64 — gateway-auth shared secret. nginx checks for the
# header; the Next.js middleware injects it; the API verifies it.
PLOWERED_GATEWAY_SECRET=GENERATE_GATEWAY_SECRET

# ---- Email ----------------------------------------------------------------
# Provider: resend | ses | log. "log" writes verification links to the
# API container logs — fine until Resend/SES is wired.
PLOWERED_EMAIL_PROVIDER=log
PLOWERED_RESEND_API_KEY=
PLOWERED_SES_REGION=
PLOWERED_EMAIL_FROM=Plowered <noreply@s2datasystems.com>

# ---- Observability ---------------------------------------------------------
PLOWERED_LOG_LEVEL=info
PLOWERED_VERSION=prod
